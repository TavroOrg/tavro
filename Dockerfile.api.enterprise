FROM python:3.12-slim

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends curl libpq-dev gcc tesseract-ocr && \
    rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://temporal.download/cli.sh | bash
ENV PATH="/root/.temporalio/bin:${PATH}"

WORKDIR /app

COPY tavro_api/requirements.txt /tmp/requirements.txt
COPY services/requirements.txt /tmp/requirements-risk.txt
COPY dist/*.whl /tmp/

# Install base deps + pdfplumber (used by enterprise compliance routers)
RUN pip install \
      -r /tmp/requirements.txt \
      -r /tmp/requirements-risk.txt \
      pdfplumber && \
    pip install /tmp/*.whl

COPY tavro_api/        /app/
COPY services          /app/services
COPY tavro_library     /app/tavro_library
COPY utils             /app/utils
COPY catalog_connector /app/catalog_connector

# Store enterprise files at /enterprise/ — outside /app so they survive
# the ./tavro_api:/app dev-mode volume mount.  The entrypoint copies them
# into /app/api/ at container start, after the volume mount is applied.
# The enterprise repo is pulled in as a named build context (see
# docker-compose.yml's additional_contexts: enterprise=../enterprise) rather
# than widening this build's own context, so each repo's .dockerignore keeps
# applying to itself.
COPY --from=enterprise api/routers/compliance.py           /enterprise/api/routers/compliance.py
COPY --from=enterprise api/routers/compliance_research.py  /enterprise/api/routers/compliance_research.py
COPY --from=enterprise api/routers/audit.py                /enterprise/api/routers/audit.py
COPY --from=enterprise api/llm.py                          /enterprise/api/llm.py
COPY --from=enterprise services                            /enterprise/services

COPY tavro_api/entrypoint.enterprise.sh /entrypoint.sh
RUN sed -i 's/\r//' /entrypoint.sh && chmod +x /entrypoint.sh

ENV PYTHONPATH=/app:/enterprise
ENV CREWAI_MAX_TOKENS=5000

EXPOSE 8000

CMD ["/entrypoint.sh"]
